{
  "name": "mandala-chart",
  "private": true,
  "description": "Mandala — local-first goal planner. No build step: these packages are only for tests and deploys.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:unit": "playwright test --project=unit",
    "test:e2e": "playwright test --project=e2e",
    "test:headed": "playwright test --project=e2e --headed",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "wrangler": "4.165.0"
  }
}
